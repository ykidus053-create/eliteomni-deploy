

# EliteOmni active model routing (verify provider availability before changing)
ELITE_MODEL_FAST=cerebras/zai-glm-4.7
ELITE_MODEL_GENERAL=cerebras/zai-glm-4.7
ELITE_MODEL_REASONING=cerebras/zai-glm-4.7
ELITE_MODEL_CODER=cerebras/zai-glm-4.7
ELITE_MODEL_RESEARCH=cerebras/zai-glm-4.7

# Quality/runtime limits
ELITE_SYSTEM_PROMPT_MAX_CHARS=32000
ELITE_SANDBOX_TIMEOUT=20

# Runtime context safety V19
CEREBRAS_CONTEXT_WINDOW=8192
CEREBRAS_MAX_OUTPUT_TOKENS=3072
ELITE_ENABLE_APO=0

# Frontier Gap V20
ELITE_FRONTIER_MODE=balanced
ELITE_CODE_RAG_TOP_K=8
ELITE_CODE_RAG_CACHE_SECONDS=20
ELITE_CODE_RAG_MAX_CHARS=26000

# Optional OpenAI-compatible frontier expert review.
ELITE_FRONTIER_BASE_URL=
ELITE_FRONTIER_API_KEY=
ELITE_FRONTIER_MODEL=
ELITE_FRONTIER_CONTEXT_WINDOW=128000
ELITE_FRONTIER_MAX_OUTPUT_TOKENS=6000
ELITE_FRONTIER_TIMEOUT_SECONDS=120

# Frontier Runtime V21
ELITE_FRONTIER_V21_MODE=balanced
ELITE_FRONTIER_V21_CANDIDATES=2
ELITE_AGENTIC_MAX_ITERS=3

# Background intelligence is opt-in to protect latency and repository integrity.
ELITE_ENABLE_PROACTIVE_DAEMON=0
ELITE_ENABLE_AGI_EMULATION=0
ELITE_ENABLE_REFACTOR_DAEMON=0
ELITE_ENABLE_SELF_HEALING=0

# Multimodal Gateway V22
MISTRAL_API_KEY=
GROQ_API_KEY=

ELITE_VISION_PROVIDER=auto
MISTRAL_VISION_MODEL=mistral-small-latest
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
MISTRAL_OCR_MODEL=mistral-ocr-latest

ELITE_DOCUMENT_OCR_MODE=auto
ELITE_PDF_LOCAL_TEXT_MIN_CHARS=120
ELITE_DOCUMENT_MAX_CHARS=250000
ELITE_MULTIMODAL_MAX_BYTES=52428800
ELITE_OCR_TIMEOUT_SECONDS=120
ELITE_VISION_TIMEOUT_SECONDS=60
ELITE_OCR_CACHE_SECONDS=3600
ELITE_RUN_LIVE_MULTIMODAL_TESTS=0

# Streaming Runtime V23
ELITE_STREAM_SMOOTHING=1
ELITE_STREAM_TARGET_BYTES=48
ELITE_STREAM_MAX_BYTES=192
ELITE_STREAM_MAX_DELAY_MS=70
ELITE_STREAM_IMMEDIATE_CHUNKS=3
ELITE_STREAM_FLUSH_NEWLINE=1
ELITE_STREAM_FLUSH_PUNCTUATION=1
ELITE_STREAM_PATHS=/stream

# Production Runtime Guard V24b
# Keep both disabled on Railway.
ELITE_SELF_WIRE=0
ELITE_SELF_WIRE_SFT=0

# Coding and Reasoning Core V27
ELITE_PROJECT_ROOT=/app
ELITE_MODEL_CODER=cerebras/zai-glm-4.7
ELITE_ENABLE_AGENT_TEAM=0
ELITE_ENABLE_LOOP_ENGINE=1
ELITE_ENABLE_SECOND_LOOP_ENGINE=0
ELITE_FRONTIER_CODER=0
ELITE_BUFFERED_VERIFICATION_STREAM=0
ELITE_CODER_REPAIR_ON_EVIDENCE=1
ELITE_CODER_MAX_TOKENS=8000

# Repository Intelligence V28
ELITE_REPO_INTELLIGENCE=1
ELITE_PROJECT_ROOT=/app
ELITE_REPO_MAX_FILES=800
ELITE_REPO_CONTEXT_FILES=10
ELITE_REPO_FILE_MAX_BYTES=262144

# Production Scope Guard V28.1
ELITE_PRODUCTION_SCOPE_DEFAULT=1
ELITE_EXPOSE_MODEL_REASONING=0
